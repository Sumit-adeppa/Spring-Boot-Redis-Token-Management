/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# Gradle (if introduced)
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Logs and temporary files
*.log
logs/
*.tmp
*.swp
*.swo

# Environment files and secrets
.env
.env.*
!.env.example

